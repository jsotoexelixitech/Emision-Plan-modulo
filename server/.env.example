# ─── Modulo Emision · Backend ──────────────────────────────────────────
PORT=4004
CORS_ORIGINS=*
JSON_BODY_LIMIT=5mb

# ─── Multi-tenant (Nexus) ─────────────────────────────────────────────
NEXUS_AUTH_ENABLED=true
TENANT_TOKEN_SECRET=
# 19=Emisión RCV · 23=Emisión Funerario · 31=Emisión Catálogo Exélixi
NEXUS_EXPECTED_SUBMODULO_IDS=19,23,31

# ─── Catálogo Exélixi (product-builder) — cotización genérica ─────────
# Mismas credenciales que ocr-api (puerto 3015 en srv001).
PRODUCT_BUILDER_API_URL=http://127.0.0.1:3015
PRODUCT_BUILDER_API_PREFIX=producto-builder-api
# PRODUCT_BUILDER_API_EMAIL=
# PRODUCT_BUILDER_API_PASSWORD=

# ─── nest-api (emisión PDF product-emission) ─────────────────────────
# HTTPS público: https://cierrelmds.exelixitech.com/nest-api-docs
NEST_API_URL=http://127.0.0.1:3002
# Canje inicial en POST /api/v1/auth/token (luego Bearer automático)
# NEST_API_KEY=   # debe incluir scopes emissions:auto y documents:write (anexo conductor)
# NEST_AUTH_USE_TOKEN=true
# URL pública del PDF conductor (navegador del cliente, no IP interna):
# NEST_PUBLIC_API_ORIGIN=https://cierrelmds.exelixitech.com
# NEST_PUBLIC_API_PREFIX=/nest-api-docs
# Deprecated (compat srv001): SYSIP_API_URL, SYSIP_API_KEY

# ─── Planes RCV ─────────────────────────────────────────────────────────
# POST {NEST_API_URL}/api/v1/valrep/planes/v2
PLANES_API_URL=
LAMUNDIAL_PRODUCTOR=80080
LAMUNDIAL_CUSUARIO=4
# Usuario Sis2000 para spBuscaPlan/calculate-plan (fn_validateCoberAccess). Default 6.
# LAMUNDIAL_CUSUARIO=4 no expone chips CA/PT/PP en catálogo.
LAMUNDIAL_CUSUARIO_PLANES=6
LAMUNDIAL_RAMO=18
# BINAC* en maplanes: cramo 28 (iplaca B). No confundir con cramoint 10 ni filas duplicadas en 18.
LAMUNDIAL_RAMO_BINACIONAL=28
LAMUNDIAL_TIMEOUT_MS=60000
LAMUNDIAL_LOG_PLANES_MAX=4000

# Cotización RCV: POST {NEST_API_URL}/api/v1/valrep/cotizacion
# Desglose coberturas: POST {NEST_API_URL}/api/v1/valrep/calculate-plan-coberturas
# COVERAGE_BREAKDOWN_ENABLED=false desactiva el desglose tras cotizar (default: true)
COVERAGE_BREAKDOWN_ENABLED=true
# Correo post-emisión: POST {NEST_API_URL}/api/v1/mail/policy-emission (scope emissions:auto; MAIL_ENABLED en nest-api)
# Solo nest-api (sin SQL directo desde emision-api)
QUOTE_SOURCE=nest-api

# Activar recibo pendiente tras emisión
COLLECTION_ENABLED=true
LAMUNDIAL_PLAN_DEFAULT=
LAMUNDIAL_FRECUENCIA_DEFAULT=A

# ─── Producto Funerario (personas, ramo 9) ───────────────────────────
# Usa el mismo nest-api (módulo personas):
#   POST /api/v1/personas/planes | /cotizacion | /emision
PERSONAS_API_URL=
PERSONAS_API_KEY=
LAMUNDIAL_RAMO_PERSON=9

# POLICY_MODE=live | mock
POLICY_MODE=live
