# ─── Modulo Emision · Backend ──────────────────────────────────────────
PORT=4004
CORS_ORIGINS=*
JSON_BODY_LIMIT=5mb

# ─── Multi-tenant (Nexus) ─────────────────────────────────────────────
NEXUS_AUTH_ENABLED=true
TENANT_TOKEN_SECRET=
NEXUS_EXPECTED_SUBMODULO_ID=19

# ─── sysip-nest-api (API central Exelixi → Sis2000) ────────────────────
# srv001: http://127.0.0.1:3002
SYSIP_API_URL=http://127.0.0.1:3002
# Opcional en QA interno (sin APIs La Mundial). Requerido cuando se active flujo maclient_api.
# SYSIP_API_KEY=

# ─── Planes RCV ─────────────────────────────────────────────────────────
# POST {SYSIP_API_URL}/api/v1/valrep/planes/v2
PLANES_API_URL=
LAMUNDIAL_PRODUCTOR=80080
LAMUNDIAL_CUSUARIO=4
LAMUNDIAL_RAMO=18
LAMUNDIAL_TIMEOUT_MS=60000
LAMUNDIAL_LOG_PLANES_MAX=4000

# Cotización RCV: POST {SYSIP_API_URL}/api/v1/valrep/cotizacion
# sysip = default (nest-api) · sis2000 = pool SQL local emision-api (legacy)
QUOTE_SOURCE=sysip

# Activar recibo pendiente tras emisión
COLLECTION_ENABLED=true
LAMUNDIAL_PLAN_DEFAULT=
LAMUNDIAL_FRECUENCIA_DEFAULT=A

# ─── Producto Funerario (personas, ramo 9) ───────────────────────────
# Usa el mismo sysip-nest-api (módulo personas):
#   POST /api/v1/personas/planes | /cotizacion | /emision
PERSONAS_API_URL=
PERSONAS_API_KEY=
LAMUNDIAL_RAMO_PERSON=9

# ─── Sis2000 SQL Server (solo si QUOTE_SOURCE=sis2000) ─────────────────
SIS2000_SERVER=172.30.149.67
SIS2000_DATABASE=sis2000_qa
SIS2000_USER=sa
SIS2000_PASSWORD=
SIS2000_TRUST_CERT=true
SIS2000_ENCRYPT=false
SIS2000_TIMEOUT=30000

# POLICY_MODE=live | mock
POLICY_MODE=live
