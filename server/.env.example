# ─── Modulo Emision · Backend ──────────────────────────────────────────
PORT=4004
CORS_ORIGINS=*
JSON_BODY_LIMIT=5mb

# ─── Multi-tenant (Nexus) ─────────────────────────────────────────────
# Si true, /api/policies/* requiere nexus_token valido.
NEXUS_AUTH_ENABLED=true
# Mismo secret configurado en nexus-api (TENANT_TOKEN_SECRET).
TENANT_TOKEN_SECRET=
# Id del submodulo Emision Plan en la BD de nexus.
NEXUS_EXPECTED_SUBMODULO_ID=19

# ─── La Mundial (cotizacion + emision corporativa) ─────────────────────
LAMUNDIAL_BASE_URL=https://qaapisys2000.lamundialdeseguros.com
# Base para valrep/planes/v2 (default: LAMUNDIAL_BASE_URL)
LAMUNDIAL_VALREP_URL=https://qaapisys2000.lamundialdeseguros.com
# apikey valrep/planes/v2 — si vacío, usa LAMUNDIAL_EMISSION_APIKEY + LAMUNDIAL_BASIC_AUTH
LAMUNDIAL_VALREP_APIKEY=
LAMUNDIAL_APIKEY=
LAMUNDIAL_PRODUCTOR=80080
LAMUNDIAL_CUSUARIO=4
LAMUNDIAL_RAMO=18
LAMUNDIAL_TIMEOUT_MS=60000
# Truncado del JSON crudo de planes en pm2 logs (default 4000; 0 = sin truncar)
LAMUNDIAL_LOG_PLANES_MAX=4000

# Emisión auto: POST {LAMUNDIAL_EMISSION_URL}/api/v1/external/createEmissionAuto
# La Mundial QA exige DOS headers (igual que sysip-nest-api):
#   apikey: LAMUNDIAL_EMISSION_APIKEY
#   Authorization: LAMUNDIAL_BASIC_AUTH
# Copiar valores desde ~/server-api-sys/.env → EXTERNAL_API_KEY y EXTERNAL_BASIC_AUTH
LAMUNDIAL_EMISSION_URL=https://qaapisys2000.lamundialdeseguros.com
LAMUNDIAL_EMISSION_APIKEY=
LAMUNDIAL_BASIC_AUTH=
LAMUNDIAL_EMISSION_PATH_PREFIX=/api/v1/external
LAMUNDIAL_DEFAULT_FREQ=A

# Cotización RCV: POST {LAMUNDIAL_QUOTE_URL}{LAMUNDIAL_QUOTE_PATH_PREFIX}/getCotizacionAuto
# Payload: { fano, cmarca, cmodelo, cversion, cplan, ccategoria_uso }
# Si no se definen LAMUNDIAL_QUOTE_*, se reutilizan LAMUNDIAL_EMISSION_* (misma API QA).
LAMUNDIAL_QUOTE_URL=https://qaapisys2000.lamundialdeseguros.com
LAMUNDIAL_QUOTE_PATH_PREFIX=/api/v1/external
LAMUNDIAL_QUOTE_APIKEY=
# lamundial_api = HTTP La Mundial (obligatorio; no usar sis2000 en producción)
QUOTE_SOURCE=lamundial_api
# Plan por defecto solo si el front no envía plan ni selectedPlan.cplan
LAMUNDIAL_PLAN_DEFAULT=

# ─── backend-api-sys (SysIP) — fuente para planes RCV (spBuscaPlan) ───
# Microservicio interno que tiene acceso directo a Sis2000_DES.
# El endpoint GET /api/catalogo/planes lo llama internamente.
SYSIP_API_URL=http://localhost:3002

# ─── Producto Funerario (personas, ramo 9) — nest-api ─────────────────
# planes/cotizacion/emision de personas se resuelven en nest-api (modulo personas):
#   POST /api/v1/personas/planes | /cotizacion | /emision
# URL del nest-api QA (o localhost del server). Debe ser alcanzable por red.
PERSONAS_API_URL=http://apiqa.exelixitech.com:3003
# apikey del canal (maclient_api) — SOLO se usa en la emision de personas.
# Pegar el token real aqui en el .env del servidor (NO commitear).
PERSONAS_API_KEY=
# Ramo de personas (funerario)
LAMUNDIAL_RAMO_PERSON=9

# ─── Sis2000 SQL Server (fallback catalogos valrep + INMA) ───────────
# Listas SEXO/EDOCIVIL/PARENTESCOS: primero La Mundial GET /api/v1/valrep/list/:tipo
# Si falla, fallback a macatvalores en Sis2000.
SIS2000_SERVER=172.30.149.67
SIS2000_DATABASE=Sis2000
SIS2000_USER=sa
SIS2000_PASSWORD=
SIS2000_TRUST_CERT=true
SIS2000_ENCRYPT=false
SIS2000_TIMEOUT=30000
