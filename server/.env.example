# ─── Modulo Emision · Backend ──────────────────────────────────────────
PORT=4004
CORS_ORIGINS=*
JSON_BODY_LIMIT=5mb

# ─── Multi-tenant (Nexus) ─────────────────────────────────────────────
# Si true, /api/policies/* requiere nexus_token valido.
NEXUS_AUTH_ENABLED=true
# Mismo secret configurado en nexus-api (TENANT_TOKEN_SECRET).
TENANT_TOKEN_SECRET=

# ─── La Mundial (cotizacion + emision corporativa) ─────────────────────
LAMUNDIAL_BASE_URL=https://qaapisys2000.lamundialdeseguros.com
LAMUNDIAL_APIKEY=
LAMUNDIAL_PRODUCTOR=80080
LAMUNDIAL_CUSUARIO=4
LAMUNDIAL_RAMO=18
LAMUNDIAL_TIMEOUT_MS=60000

# Plan por defecto si no llega en el body
LAMUNDIAL_DEFAULT_PLAN=RCVBAS
LAMUNDIAL_DEFAULT_FREQ=A
